APP_NAME=skeleton
APP_ENV=dev

DB_DRIVER=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=hyperf
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci
DB_PREFIX=hyperf_

REDIS_HOST=localhost
REDIS_AUTH=(null)
REDIS_PORT=6379
REDIS_DB=1
CACHE_PREFIX=hyperf_

MAILER_DSN=smtp://你的QQ邮箱:你的SMTP授权码@smtp.qq.com:465
MAIL_FROM_ADDRESS=你的QQ邮箱
MAIL_FROM_NAME=HyperfVue
FRONTEND_URL=http://localhost:5173

JWT_SECRET=
JWT_TTL=3600
